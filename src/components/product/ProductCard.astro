---
import type { CollectionEntry } from "astro:content";

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const image = product.data.images[0];
---

<article class="group overflow-hidden rounded-[var(--radius-card)] bg-[#07172c] text-white transition duration-300 hover:-translate-y-1 hover:shadow-[var(--shadow-card)]">
  <a href={`/products/${product.data.slug}/`} class="flex h-full flex-col">
    <div class="aspect-[4/3] overflow-hidden bg-[#eaf1f8] p-8">
      <img
        src={image.src}
        alt={image.alt}
        width="800"
        height="620"
        loading="lazy"
        class="h-full w-full object-contain transition duration-700 group-hover:scale-[1.03]"
      />
    </div>
    <div class="flex flex-1 flex-col p-7">
      <h3 class="text-2xl font-semibold leading-tight tracking-[-0.04em]">{product.data.title}</h3>
      <p class="mt-4 text-sm leading-7 text-white/60">{product.data.summary}</p>
      <span class="mt-auto inline-flex items-center gap-3 pt-7 text-[10px] font-bold uppercase tracking-[0.16em] text-[var(--color-accent)]">Explore platform <span aria-hidden="true">↗</span></span>
    </div>
  </a>
</article>
