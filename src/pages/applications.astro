---
import ContactCta from "../components/sections/ContactCta.astro";
import PageHero from "../components/sections/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { makePageTitle } from "../lib/seo";

const applications = [
  {
    title: "Electric two-wheelers",
    copy: "Battery packs for e-bikes, e-scooters and e-motorcycles, with range, charging and enclosure requirements matched to the vehicle.",
    image: "/media/products/ebike-battery.jpg",
    alt: "Lithium battery pack for an electric two-wheeler",
    platform: "E-bike & e-motorcycle packs",
    href: "/products/e-bike-battery-packs/",
  },
  {
    title: "Golf & utility carts",
    copy: "Deep-cycle LiFePO4 configurations for low-speed vehicles and utility fleets where stable power and service life matter.",
    image: "/media/applications/golf-cart.jpg",
    alt: "Golf cart using a lithium battery pack",
    platform: "12V LiFePO4 replacement",
    href: "/products/12v-lifepo4-replacement/",
  },
  {
    title: "Mobility devices",
    copy: "Compact, reliable power for electric wheelchairs and personal mobility equipment, configured around the installation and duty cycle.",
    image: "/media/applications/wheelchair.jpg",
    alt: "Electric wheelchair in an outdoor setting",
    platform: "E-bike & e-motorcycle packs",
    href: "/products/e-bike-battery-packs/",
  },
  {
    title: "Floor-care equipment",
    copy: "High-cycle battery systems for commercial cleaning and industrial equipment that operates through repeated daily cycles.",
    image: "/media/applications/floor-care.jpg",
    alt: "Commercial floor-care machine",
    platform: "12V LiFePO4 replacement",
    href: "/products/12v-lifepo4-replacement/",
  },
  {
    title: "Ride-on vehicles",
    copy: "Application-matched packs for children's ride-on vehicles and light-duty electric products, with safety and cost balanced for the project.",
    image: "/media/applications/kids-kart.jpg",
    alt: "Children driving a battery-powered ride-on vehicle",
    platform: "12V LiFePO4 replacement",
    href: "/products/12v-lifepo4-replacement/",
  },
  {
    title: "Residential & commercial storage",
    copy: "Wall-mounted and stackable systems for home storage, backup power and small commercial installations.",
    image: "/media/products/home-storage.jpg",
    alt: "Wall-mounted and stackable home energy storage battery",
    platform: "Home energy storage",
    href: "/products/home-energy-storage/",
  },
];

const inputs = [
  "Operating voltage and capacity",
  "Continuous and peak discharge",
  "Expected duty cycle and service life",
  "Enclosure dimensions and mounting method",
  "Charging and communication interface",
  "Target market requirements and volume",
];
---

<BaseLayout
  title={makePageTitle("Applications")}
  description="Lithium battery applications for electric two-wheelers, golf carts, mobility devices, floor-care equipment, ride-on vehicles and energy storage."
  image="/media/applications/golf-cart.jpg"
>
  <PageHero
    eyebrow="Application engineering"
    title="One battery partner across demanding duty cycles."
    description="From short-distance mobility to backup power and daily storage, the pack is configured around how the equipment actually operates."
    image="/media/applications/golf-cart.jpg"
    imageAlt="Golf cart powered by a lithium battery"
    facts={[
      { value: "6", label: "Application areas" },
      { value: "2,000+", label: "Packs produced daily" },
      { value: "3 + 3", label: "Production lines" },
      { value: "20+", label: "Markets served" },
    ]}
  />

  <section class="bg-white py-20 sm:py-24">
    <div class="site-container">
      <div class="max-w-3xl">
        <p class="eyebrow">Where our packs are used</p>
        <h2 class="mt-4 text-4xl font-semibold leading-[0.96] tracking-[-0.055em] sm:text-6xl">Different equipment. One specification discipline.</h2>
        <p class="mt-5 text-base leading-7 text-[var(--color-muted)]">Each project starts with the real load profile, installation space and operating environment, not a generic battery catalogue.</p>
      </div>

      <div class="mt-11 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {applications.map((application) => (
          <article class="group flex flex-col overflow-hidden rounded-[var(--radius-card)] border border-[var(--color-line)] bg-white">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={application.image}
                alt={application.alt}
                width="553"
                height="380"
                loading="lazy"
                class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">{application.platform}</p>
              <h3 class="mt-3 text-2xl font-semibold leading-tight tracking-[-0.035em]">{application.title}</h3>
              <p class="mt-3 text-sm leading-7 text-[var(--color-muted)]">{application.copy}</p>
              <a href={application.href} class="mt-auto inline-flex items-center gap-3 pt-6 text-[10px] font-bold uppercase tracking-[0.16em] text-[var(--color-primary)]">View platform <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[#07172c] py-20 text-white sm:py-24">
    <div class="site-container grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:gap-20">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--color-accent)]">Specification inputs</p>
        <h2 class="mt-4 max-w-xl text-4xl font-semibold leading-[0.96] tracking-[-0.055em] sm:text-5xl">What we need to match the pack.</h2>
        <p class="mt-5 max-w-lg text-sm leading-7 text-white/55">A short application brief is enough to start the review. Our team will identify the technical details that still need confirmation.</p>
      </div>
      <ol class="grid gap-x-8 border-t border-white/15 sm:grid-cols-2">
        {inputs.map((input, index) => (
          <li class="flex gap-5 border-b border-white/15 py-5">
            <span class="text-[10px] font-bold tracking-[0.16em] text-[var(--color-accent)]">0{index + 1}</span>
            <span class="text-base font-semibold leading-6 tracking-[-0.02em]">{input}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
