---
import ContactCta from "../components/sections/ContactCta.astro";
import PageHero from "../components/sections/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  {
    number: "01",
    title: "Requirement & design",
    copy: "Review the application, voltage, capacity, duty cycle, enclosure and interface. Define the cell, BMS and pack architecture.",
  },
  {
    number: "02",
    title: "Modeling & first article",
    copy: "Develop the pack layout, build the first article and inspect fit, finish and assembly details.",
  },
  {
    number: "03",
    title: "Validation & aging",
    copy: "Run capacity checks, testing and aging before the configuration is released for repeat production.",
  },
  {
    number: "04",
    title: "Batch production",
    copy: "Assemble, test and grade packs under the same quality process across power and storage production lines.",
  },
  {
    number: "05",
    title: "Packing & shipment",
    copy: "Final inspection, packaging and shipment preparation for the agreed delivery destination.",
  },
];

const services = [
  {
    title: "Before the project",
    items: ["Technical consultation", "Product information", "Application and selection review"],
  },
  {
    title: "During production",
    items: ["Factory visit support", "Production progress updates", "Technical training"],
  },
  {
    title: "After delivery",
    items: ["Fast issue response", "Warranty handling", "Ongoing technical support"],
  },
];
---

<BaseLayout
  title="OEM & ODM Lithium Battery Packs | ZBPOWER"
  description="Custom lithium battery development from specification and pack design through first article, validation and series production."
  image="/media/company/production-line-alt.jpg"
>
  <PageHero
    eyebrow="OEM & ODM"
    title="From your specification to series production."
    description="One team covers pack design, BMS integration, prototype validation, aging and volume assembly at our Dongguan production base."
    image="/media/company/production-line-alt.jpg"
    imageAlt="ZBPOWER battery pack production line"
    facts={[
      { value: "20+", label: "R&D team" },
      { value: "24", label: "Patent applications" },
      { value: "25%", label: "Revenue invested in R&D" },
      { value: "5", label: "Delivery stages" },
    ]}
  />

  <section class="bg-white py-20 sm:py-24">
    <div class="site-container grid gap-12 lg:grid-cols-[.78fr_1.22fr] lg:gap-20">
      <div class="lg:sticky lg:top-12 lg:self-start">
        <p class="eyebrow">How a custom pack is built</p>
        <h2 class="mt-4 text-4xl font-semibold leading-[0.96] tracking-[-0.055em] sm:text-6xl">One line of responsibility.</h2>
        <p class="mt-5 max-w-lg text-base leading-7 text-[var(--color-muted)]">The same team remains involved from the first technical review through the released production configuration.</p>
        <a href="/contact/" class="mt-8 inline-flex min-h-12 items-center justify-center bg-[var(--color-primary)] px-6 py-3 text-[10px] font-bold uppercase tracking-[0.16em] text-white transition hover:bg-[var(--color-primary-dark)]">Start a project review</a>
      </div>

      <ol class="border-t border-[var(--color-line)]">
        {steps.map((step) => (
          <li class="grid gap-4 border-b border-[var(--color-line)] py-7 sm:grid-cols-[4rem_1fr] sm:gap-8">
            <span class="text-[10px] font-bold tracking-[0.16em] text-[var(--color-primary)]">{step.number}</span>
            <div>
              <h3 class="text-2xl font-semibold tracking-[-0.035em]">{step.title}</h3>
              <p class="mt-2 max-w-2xl text-sm leading-7 text-[var(--color-muted)]">{step.copy}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-[var(--color-surface)] py-20 sm:py-24">
    <div class="site-container grid items-stretch gap-4 lg:grid-cols-[.95fr_1.05fr]">
      <div class="relative min-h-[420px] overflow-hidden rounded-[var(--radius-card)] lg:min-h-[560px]">
        <img src="/media/company/production-line.jpg" alt="Battery pack assembly at ZBPOWER" width="2039" height="1252" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(5,20,42,.78),transparent_58%)]"></div>
        <p class="absolute inset-x-0 bottom-0 p-7 text-2xl font-semibold tracking-[-0.035em] text-white sm:p-10 sm:text-3xl">Design, assembly, aging and testing stay under one quality system.</p>
      </div>
      <div class="rounded-[var(--radius-card)] bg-white p-7 sm:p-10 lg:p-12">
        <p class="eyebrow">R&D capability</p>
        <h2 class="mt-4 text-4xl font-semibold leading-[0.98] tracking-[-0.055em] sm:text-5xl">Engineering that reaches the production line.</h2>
        <p class="mt-5 text-sm leading-7 text-[var(--color-muted)] sm:text-base sm:leading-8">ZBPOWER invests continuously in battery management, pack structure and production validation. More than half of its patent applications are invention patents.</p>
        <div class="mt-8 grid grid-cols-2 gap-6 border-y border-[var(--color-line)] py-7">
          <div><p class="text-3xl font-semibold tracking-[-0.05em]">20+</p><p class="mt-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[var(--color-muted)]">R&D staff</p></div>
          <div><p class="text-3xl font-semibold tracking-[-0.05em]">60%+</p><p class="mt-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[var(--color-muted)]">Invention patents</p></div>
          <div><p class="text-3xl font-semibold tracking-[-0.05em]">100</p><p class="mt-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[var(--color-muted)]">Team members</p></div>
          <div><p class="text-3xl font-semibold tracking-[-0.05em]">20+</p><p class="mt-1 text-[9px] font-bold uppercase tracking-[0.14em] text-[var(--color-muted)]">Quality staff</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-20 sm:py-24">
    <div class="site-container">
      <div class="max-w-3xl">
        <p class="eyebrow">Project support</p>
        <h2 class="mt-4 text-4xl font-semibold leading-[0.96] tracking-[-0.055em] sm:text-5xl">Support beyond the quotation.</h2>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {services.map((service, index) => (
          <article class="border-t border-[var(--color-line)] pt-6">
            <p class="text-[10px] font-bold tracking-[0.16em] text-[var(--color-primary)]">0{index + 1}</p>
            <h3 class="mt-3 text-2xl font-semibold tracking-[-0.035em]">{service.title}</h3>
            <ul class="mt-4 space-y-3 text-sm leading-6 text-[var(--color-muted)]">
              {service.items.map((item) => <li class="border-b border-[var(--color-line)] pb-3">{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ContactCta />
</BaseLayout>
